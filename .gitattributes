# Auto detect text files and perform LF normalization
* text=auto

# Go source files
*.go text eol=lf

# Shell scripts
*.sh text eol=lf

# YAML / TOML / JSON
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.json text eol=lf

# Markdown
*.md text eol=lf

# Python
*.py text eol=lf

# JavaScript
*.js text eol=lf

# Windows scripts (keep CRLF)
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binaries
*.exe binary
*.zip binary
*.tar.gz binary
*.png binary
*.jpg binary
*.mp4 binary
*.mp3 binary
